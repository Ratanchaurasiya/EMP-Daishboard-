# ==============================================================================
# AssetCore & Service Management System - Environment Configuration
# ==============================================================================

# 1. PRODUCTION POSTGRESQL DATABASE (REQUIRED IN PRODUCTION)
# Format for Render Managed PostgreSQL (Internal / External URL with SSL):
# DATABASE_URL=postgresql://assetcore_user:your_password@dpg-xxxxx-a.oregon-postgres.render.com/assetcore?sslmode=require
DATABASE_URL=

# 2. NODE ENVIRONMENT
# Set to 'production' for live deployments.
NODE_ENV=production

# 3. SERVER PORT
# Render automatically injects PORT (e.g. 10000). In local dev, defaults to 5050.
PORT=10000

# 4. CORS ORIGIN
# Set to '*' or comma-separated allowed domains:
# Example: CORS_ORIGIN=https://my-frontend.onrender.com,https://my-app.vercel.app
CORS_ORIGIN=*

# 5. FRONTEND API BASE URL (FOR SPLIT DEPLOYMENTS ONLY)
# If frontend and backend are deployed together on the SAME Render Web Service, LEAVE THIS EMPTY.
# Only if frontend is deployed on Vercel/Netlify and backend is on Render:
# VITE_API_BASE_URL=https://my-backend-service.onrender.com
VITE_API_BASE_URL=
